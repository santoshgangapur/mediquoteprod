{
  "entities": {
    "SurgicalCase": {
      "title": "Surgical Case",
      "description": "Surgical procedure case dossier with AI clinical recommendations and hospital quotes",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "patientId": { "type": "string" },
        "patientName": { "type": "string" },
        "caseCode": { "type": "string" },
        "title": { "type": "string" },
        "diagnosis": { "type": "string" },
        "status": { "type": "string" },
        "severity": { "type": "string" },
        "dateCreated": { "type": "string" },
        "targetBudgetINR": { "type": "number" },
        "insurancePolicy": { "type": "string" },
        "hospitalsCount": { "type": "number" }
      },
      "required": ["id", "title", "caseCode", "status"]
    },
    "Hospital": {
      "title": "Hospital",
      "description": "Empanelled hospital partner profile and accreditation details",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "city": { "type": "string" },
        "status": { "type": "string" },
        "rating": { "type": "number" },
        "bedCapacity": { "type": "number" },
        "contactPerson": { "type": "string" },
        "phone": { "type": "string" },
        "websiteUrl": { "type": "string" }
      },
      "required": ["id", "name", "city", "status"]
    },
    "FamilyMember": {
      "title": "Family Member",
      "description": "Linked family member or primary patient profile",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "fullName": { "type": "string" },
        "relationship": { "type": "string" },
        "age": { "type": "number" },
        "gender": { "type": "string" },
        "bloodGroup": { "type": "string" },
        "abhaId": { "type": "string" },
        "isPrimary": { "type": "boolean" }
      },
      "required": ["id", "fullName", "relationship"]
    },
    "VaultDocument": {
      "title": "Vault Document",
      "description": "Medical DigiLocker encrypted medical record or diagnostic document",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "patientMemberId": { "type": "string" },
        "patientMemberName": { "type": "string" },
        "title": { "type": "string" },
        "category": { "type": "string" },
        "fileName": { "type": "string" },
        "fileSize": { "type": "string" },
        "uploadDate": { "type": "string" },
        "sha256Hash": { "type": "string" },
        "encryptionProtocol": { "type": "string" },
        "abdmComplianceSeal": { "type": "boolean" },
        "isLocked": { "type": "boolean" }
      },
      "required": ["id", "title", "category", "fileName"]
    },
    "UserProfile": {
      "title": "User Profile",
      "description": "Registered user account profile",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "fullName": { "type": "string" },
        "mobileNumber": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string" },
        "abhaId": { "type": "string" },
        "status": { "type": "string" },
        "joinedDate": { "type": "string" }
      },
      "required": ["id", "fullName", "mobileNumber", "role"]
    }
  },
  "firestore": {
    "/surgical_cases/{caseId}": {
      "schema": "SurgicalCase",
      "description": "Collection of all surgical case dossiers"
    },
    "/hospitals/{hospitalId}": {
      "schema": "Hospital",
      "description": "Collection of empanelled hospital partners"
    },
    "/family_members/{memberId}": {
      "schema": "FamilyMember",
      "description": "Collection of patient family members and profiles"
    },
    "/vault_documents/{docId}": {
      "schema": "VaultDocument",
      "description": "Encrypted medical DigiLocker documents and clinical reports"
    },
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Registered user accounts and role definitions"
    }
  }
}
